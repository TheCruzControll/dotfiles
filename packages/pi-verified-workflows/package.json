{
  "name": "pi-verified-workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable Pi skills and helper scripts for source-backed rendering, evidence checks, and approval-gated GitHub workflows.",
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "node --test",
    "test:renderer": "node --test tests/source-preview/*.test.mjs",
    "test:evidence": "node --test tests/evidence/*.test.mjs",
    "test:github": "node --test tests/github/*.test.mjs",
    "source-preview:check": "node ./scripts/source-preview/check.mjs",
    "source-preview:render": "node ./scripts/source-preview/render.mjs",
    "evidence:check": "node ./scripts/evidence/check.mjs",
    "submission:check": "node ./scripts/evidence/submission-check.mjs",
    "github:plan": "node ./scripts/github/plan.mjs",
    "github:apply": "node ./scripts/github/apply.mjs"
  }
}
